{
  "$defs": {
    "Activity": {
      "enum": [
        "RESTING",
        "OTHER",
        "UNKNOWN"
      ],
      "title": "Activity",
      "type": "string"
    },
    "Audio": {
      "additionalProperties": false,
      "properties": {
        "context": {
          "$ref": "#/$defs/AudioContext"
        },
        "confidence": {
          "description": "신뢰도 0~1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "context",
        "confidence"
      ],
      "title": "Audio",
      "type": "object"
    },
    "AudioContext": {
      "enum": [
        "SILENT",
        "SPEECH",
        "CONVERSATION",
        "MUSIC",
        "TV",
        "LOUD_NOISE",
        "UNKNOWN"
      ],
      "title": "AudioContext",
      "type": "string"
    },
    "Change": {
      "additionalProperties": false,
      "properties": {
        "type": {
          "$ref": "#/$defs/ChangeType"
        },
        "track_id": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "사람 단위 변화면 해당 track_id, 방 단위 변화면 null",
          "title": "Track Id"
        }
      },
      "required": [
        "type",
        "track_id"
      ],
      "title": "Change",
      "type": "object"
    },
    "ChangeType": {
      "enum": [
        "PERSON_ENTERED",
        "PERSON_LEFT",
        "IDENTITY_CHANGED",
        "POSTURE_CHANGED",
        "ACTIVITY_CHANGED",
        "OCCUPANCY_CHANGED",
        "AUDIO_CHANGED",
        "LIGHT_CHANGED"
      ],
      "title": "ChangeType",
      "type": "string"
    },
    "EventType": {
      "enum": [
        "HEARTBEAT",
        "STATE_CHANGE"
      ],
      "title": "EventType",
      "type": "string"
    },
    "IdentitySource": {
      "enum": [
        "FACE",
        "VOICE",
        "TRACK_CARRIED",
        "UNKNOWN"
      ],
      "title": "IdentitySource",
      "type": "string"
    },
    "Light": {
      "enum": [
        "DARK",
        "DIM",
        "BRIGHT",
        "UNKNOWN"
      ],
      "title": "Light",
      "type": "string"
    },
    "Motion": {
      "description": "레이더 기준 움직임 정도.",
      "enum": [
        "STILL",
        "SLIGHT",
        "ACTIVE",
        "UNKNOWN"
      ],
      "title": "Motion",
      "type": "string"
    },
    "Occupancy": {
      "additionalProperties": false,
      "description": "방 단위 재실 (LD2410C 주). 위치를 놓쳐도 사람이 있으면 OCCUPIED + persons: [].",
      "properties": {
        "state": {
          "$ref": "#/$defs/OccupancyState"
        },
        "confidence": {
          "description": "신뢰도 0~1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "state",
        "confidence"
      ],
      "title": "Occupancy",
      "type": "object"
    },
    "OccupancyState": {
      "enum": [
        "OCCUPIED",
        "EMPTY",
        "UNKNOWN"
      ],
      "title": "OccupancyState",
      "type": "string"
    },
    "Person": {
      "additionalProperties": false,
      "properties": {
        "track_id": {
          "description": "Node 안에서 사람을 구분하는 번호. 방을 나가면 재사용될 수 있음",
          "minimum": 0,
          "title": "Track Id",
          "type": "integer"
        },
        "identity": {
          "description": "등록된 가족 이름(영문 대문자) 또는 예약어 UNKNOWN / GUEST",
          "pattern": "^[A-Z][A-Z0-9_]*$",
          "title": "Identity",
          "type": "string"
        },
        "identity_confidence": {
          "description": "신뢰도 0~1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Identity Confidence",
          "type": "number"
        },
        "identity_source": {
          "$ref": "#/$defs/IdentitySource"
        },
        "posture": {
          "$ref": "#/$defs/Posture"
        },
        "posture_confidence": {
          "description": "신뢰도 0~1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Posture Confidence",
          "type": "number"
        },
        "motion": {
          "$ref": "#/$defs/Motion"
        },
        "activity": {
          "$ref": "#/$defs/Activity"
        },
        "activity_confidence": {
          "description": "신뢰도 0~1",
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Activity Confidence",
          "type": "number"
        },
        "position": {
          "anyOf": [
            {
              "$ref": "#/$defs/Position"
            },
            {
              "type": "null"
            }
          ],
          "description": "레이더가 없거나 위치를 모르면 null"
        }
      },
      "required": [
        "track_id",
        "identity",
        "identity_confidence",
        "identity_source",
        "posture",
        "posture_confidence",
        "motion",
        "activity",
        "activity_confidence",
        "position"
      ],
      "title": "Person",
      "type": "object"
    },
    "Position": {
      "additionalProperties": false,
      "description": "방 기준 좌표, 미터 단위. 원점·축 방향은 팀원2와 합의 예정.",
      "properties": {
        "x": {
          "title": "X",
          "type": "number"
        },
        "y": {
          "title": "Y",
          "type": "number"
        }
      },
      "required": [
        "x",
        "y"
      ],
      "title": "Position",
      "type": "object"
    },
    "Posture": {
      "enum": [
        "STANDING",
        "SITTING",
        "LYING",
        "WALKING",
        "UNKNOWN"
      ],
      "title": "Posture",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "방 전체 스냅샷. 메시지 하나만 받아도 방 상태를 알 수 있다.",
  "properties": {
    "schema_version": {
      "const": "0.1",
      "default": "0.1",
      "title": "Schema Version",
      "type": "string"
    },
    "event_id": {
      "format": "uuid",
      "title": "Event Id",
      "type": "string"
    },
    "node_id": {
      "description": "소문자, 숫자, 밑줄",
      "pattern": "^[a-z0-9_]+$",
      "title": "Node Id",
      "type": "string"
    },
    "room_id": {
      "description": "소문자, 숫자, 밑줄",
      "pattern": "^[a-z0-9_]+$",
      "title": "Room Id",
      "type": "string"
    },
    "timestamp": {
      "description": "ISO 8601, 시간대 포함",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
    "seq": {
      "description": "Node별 일련번호. 1씩 증가, 빠진 번호 = 유실. Node 재시작 시 0부터",
      "minimum": 0,
      "title": "Seq",
      "type": "integer"
    },
    "event_type": {
      "$ref": "#/$defs/EventType"
    },
    "changes": {
      "description": "HEARTBEAT면 빈 리스트",
      "items": {
        "$ref": "#/$defs/Change"
      },
      "title": "Changes",
      "type": "array"
    },
    "occupancy": {
      "$ref": "#/$defs/Occupancy"
    },
    "persons": {
      "description": "위치·신원을 추적 중인 사람들. 방을 나간 사람은 빠짐",
      "items": {
        "$ref": "#/$defs/Person"
      },
      "title": "Persons",
      "type": "array"
    },
    "audio": {
      "$ref": "#/$defs/Audio"
    },
    "light": {
      "$ref": "#/$defs/Light"
    }
  },
  "required": [
    "schema_version",
    "event_id",
    "node_id",
    "room_id",
    "timestamp",
    "seq",
    "event_type",
    "changes",
    "occupancy",
    "persons",
    "audio",
    "light"
  ],
  "title": "NodeStateMessage",
  "type": "object"
}
