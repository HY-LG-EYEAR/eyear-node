      "type": "string"
    },
    "room_id": {
      "description": "소문자, 숫자, 밑줄",
      "pattern": "^[a-z0-9_]+$",
      "title": "Room Id",
      "type": "string"
    },
    "timestamp": {
      "description": "ISO 8601, 시간대 포함",
      "format": "date-time",
      "title": "Timestamp",
      "type": "string"
    },
